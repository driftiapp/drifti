{
  "name": "driftix",
  "version": "1.0.0",
  "description": "Secure secrets and backup management system",
  "main": "scripts/manage-backups.js",
  "scripts": {
    "build": "next build",
    "test:env": "node scripts/test-env.js",
    "rotate-secrets": "node scripts/rotate-secrets.js",
    "manage-backups": "node -r dotenv/config scripts/manage-backups.js",
    "setup": "./scripts/setup-env.sh",
    "dev": "next dev",
    "dev:backup": "nodemon scripts/manage-backups.js",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "dev:watch": "concurrently \"npm run dev\" \"npm run dev:backup\" \"npm run typecheck\" \"npm run lint\"",
    "clean": "rimraf dist .next node_modules",
    "prepare": "husky install",
    "check:types": "node scripts/check-types.js",
    "check:paths": "node scripts/check-paths.js",
    "check:all": "npm run check:types && npm run check:paths",
    "gitpush": "gitpush start"
