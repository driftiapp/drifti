{
  "name": "driftix",
  "version": "1.0.0",
  "description": "Secure secrets and backup management system",
  "main": "scripts/manage-backups.js",
  "scripts": {
    "build": "npm install && tsc",
    "test:env": "node scripts/test-env.js",
    "rotate-secrets": "node scripts/rotate-secrets.js",
    "manage-backups": "node scripts/manage-backups.js",
    "setup": "./scripts/setup-env.sh",
    "dev": "nodemon",
    "start": "node -r dotenv/config scripts/manage-backups.js",
    "lint": "eslint . --ext .js,.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "dev:watch": "concurrently \"npm run dev\" \"npm run typecheck -- --watch\" \"npm run lint -- --watch\"",
    "clean": "rimraf dist .next node_modules",
    "prepare": "husky install",
    "check:types": "node scripts/check-types.js",
    "check:paths": "node scripts/check-paths.js",
    "check:all": "npm run check:types && npm run check:paths"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.11",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toast": "^1.2.11",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "commander": "^11.1.0",
    "inquirer": "^8.2.6",
    "next-intl": "^4.0.3",
    "node-cron": "^3.0.3",
    "react-day-picker": "^9.6.7",
    "react-hook-form": "^7.56.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/exceljs": "^0.5.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.0",
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^20.17.30",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/stripe": "^8.0.416",
    "concurrently": "^9.1.2",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "author": "",
  "license": "ISC"
}