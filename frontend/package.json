{
  "name": "driftix-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:prod": "NODE_ENV=production next build",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start",
    "lint": "next lint",
    "export": "next build && next export",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next out",
    "clean:all": "rm -rf .next out node_modules/.cache",
    "deploy": "chmod +x ./scripts/deploy-ga4.sh && ./scripts/deploy-ga4.sh",
    "setup-monitoring": "node ./scripts/setup-monitoring.js",
    "setup-alerts": "node ./scripts/setup-alerts.js",
    "deploy:prod": "NODE_ENV=production npm run deploy",
    "deploy:staging": "NODE_ENV=staging npm run deploy"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@firebase/auth": "^1.9.1",
    "@firebase/firestore": "^4.7.10",
    "@firebase/storage": "^0.13.7",
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^6.1.0",
    "@tanstack/react-query": "^5.70.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mapbox-gl": "^3.4.1",
    "@web3-react/core": "^8.2.3",
    "axios": "^1.8.4",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.4.1",
    "critters": "^0.0.23",
    "date-fns": "^2.30.0",
    "ethers": "^6.13.5",
    "firebase": "^11.5.0",
    "framer-motion": "^11.0.3",
    "mapbox-gl": "^3.10.0",
    "next": "^15.2.4",
    "postcss-preset-env": "^10.1.5",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3"
  }
}
